# Copy to .env and fill in.

# Comma-separated; `python app/run.py --list-retailers` lists the names.
RETAILERS=lookfantastic,boots,johnlewis

# json, csv, or both.
OUTPUT_FORMATS=csv

WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
# Two-letter country for the exit IPs; blank means anywhere.
WEBSHARE_COUNTRY=gb
# The Webshare endpoint to connect to.
WEBSHARE_HOST=p.webshare.io
WEBSHARE_PORT=80

# Only for a fixed host:port list, comma-separated. Leave blank to use the
# endpoint above, which is what rotating residential needs.
WEBSHARE_PROXIES=

# true skips the proxies and scrapes from this machine's own IP.
ALLOW_DIRECT=false

# All three, or nothing is uploaded.
GCP_PROJECT=
GCS_BUCKET=
BQ_DATASET=

# BQ Table names for the runs, products, campaigns, and mapping tables.
BQ_TABLE_RUNS=runs
BQ_TABLE_PRODUCTS=products
BQ_TABLE_CAMPAIGNS=campaigns
BQ_TABLE_MAPPING=campaigns_products_mapping

DELETE_LOCAL_AFTER_UPLOAD=true
