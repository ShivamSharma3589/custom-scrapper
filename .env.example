# Copy this file to .env and fill it in. .env is ignored by git.
# Webshare proxies, used by John Lewis when it starts refusing requests.
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
# host:port of each proxy, comma-separated
WEBSHARE_PROXIES=

ALLOW_DIRECT=false

# --- Google Cloud (production only) -------------------------------------
# Leave these empty on a laptop: the scraper then writes to disk and nothing
# is uploaded. Fill all three in production and every run is archived to the
# bucket and loaded into BigQuery.
GCP_PROJECT=
GCS_BUCKET=
BQ_DATASET=

# Point this at a service-account key file with Storage + BigQuery access.
GOOGLE_APPLICATION_CREDENTIALS=

# Delete a local file once Cloud Storage confirms it has a copy.
DELETE_LOCAL_AFTER_UPLOAD=true
