# Copy to .env and fill in.

# Comma-separated; `python app/run.py --list-retailers` lists the names.
RETAILERS=lookfantastic

# json, csv, or both.
OUTPUT_FORMATS=csv

WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=
# host:port, comma-separated
WEBSHARE_PROXIES=

# true skips the proxies and scrapes from this machine's own IP.
ALLOW_DIRECT=false

# All three, or nothing is uploaded.
GCP_PROJECT=
GCS_BUCKET=
BQ_DATASET=

GOOGLE_APPLICATION_CREDENTIALS=

DELETE_LOCAL_AFTER_UPLOAD=true
